{
  "name": "repertoire-trainer",
  "version": "0.3.0",
  "description": "A local, MoveTrainer-style opening trainer with spaced repetition and Stockfish.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "test": "c8 node --test --test-timeout=30000 --test-force-exit test/*.test.mjs",
    "test:smoke": "node test/smoke-server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node test/e2e/coverage.mjs",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "mock-lichess": "node test/mock-lichess.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lichess-org/chessground": "10.4.2",
    "chess.js": "1.4.0",
    "express": "5.3.0",
    "stockfish": "19.0.1",
    "ws": "8.22.0"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
