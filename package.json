{
  "name": "repertoire-trainer",
  "version": "0.3.0",
  "description": "A local, MoveTrainer-style opening trainer with spaced repetition and Stockfish.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/smoke-server.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "mock-lichess": "node test/mock-lichess.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "stockfish": "^19.0.1",
    "ws": "^8.22.0"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
