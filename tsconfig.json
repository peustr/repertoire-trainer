{
  // Type-checks every JavaScript file (npm run check), with JSDoc for the types inference
  // cannot see. Nothing is compiled: what is in public/ is still exactly what the browser loads.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true, // every file, and none can opt out: lint refuses @ts-nocheck, @ts-ignore and @ts-expect-error
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    // A value that may be null or undefined has to be checked before it is used. In tests,
    // must() (test/helpers/must.mjs) does that for a value the test expects to be there.
    "strictNullChecks": true
  },
  "include": ["*.js", "*.cjs", "*.mjs", "public/js/**/*.js", "test/**/*.mjs", "test/**/*.js", "test/**/*.cjs"],
  "exclude": ["node_modules", "data"]
}
