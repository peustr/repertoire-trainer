{
  // Type-checks the plain JavaScript files that start with // @ts-check (npm run check). Nothing is compiled: what is in
  // public/ is still exactly what the browser loads.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true, // every file; a few older ones still opt out with // @ts-nocheck
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["*.js", "*.cjs", "*.mjs", "public/js/**/*.js", "test/**/*.mjs", "test/**/*.js"],
  "exclude": ["node_modules", "data"]
}
